generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum EFinanceEntryStatus {
  PENDING
  PAID
  CANCELLED
}

enum EFinanceEntryType {
  INCOME
  EXPENSE
  STUDENTS
}

enum EPaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  PIX
  BOLETO
}

enum EGraduation {
  // Kruang-Prajied. A ordem de declaração importa: no Postgres o enum
  // ordena por ela, então ORDER BY graduation já sai na ordem dos graus.
  GRAU_1
  GRAU_2
  GRAU_3
  GRAU_4
  GRAU_5
  GRAU_6
  GRAU_7
  GRAU_8
  GRAU_9
  GRAU_10
  GRAU_11
}

enum ECategoryStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  FinanceEntry FinanceEntry[]
  Category     Category[]
  Plan         Plan[]
  Student      Student[]
  Supplier     Supplier[]

  promotions       Promotion[]
  whatsappConfig   WhatsappConfig?
  messageTemplates MessageTemplate[]
  messageLogs      MessageLog[]
}

model Student {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  phone      String
  avatar     String?
  birthDate  DateTime?
  // opcional: alunos existentes ficam sem graduação até o professor definir
  graduation EGraduation?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  enrollments Enrollment[]
  payments    Payment[]
  messageLogs MessageLog[]

  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  FinanceEntry FinanceEntry[]
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  price       Float
  duration    Int // Quantidade de meses
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(uuid())
  /// Valor cheio da parcela. O recebido é amount - discountAmount.
  amount         Decimal
  paymentDate    DateTime      @default(now())
  dueDate        DateTime
  status         PaymentStatus @default(PENDING)
  discountAmount Decimal       @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
}

model Expense {
  id        String   @id @default(uuid())
  title     String
  amount    Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  Category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  supplierId String?
  Supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

// ----------------------------------- FINANCEIRO --------------------------------

model FinanceEntry {
  id            String              @id @default(uuid())
  date          DateTime
  amount        Float
  paymentMethod EPaymentMethod?
  description   String?
  referenceId   String?
  type          EFinanceEntryType
  status        EFinanceEntryStatus @default(PENDING)
  currency      String?             @default("BRL")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, status])
}

model Category {
  id          String          @id @default(uuid())
  name        String
  status      ECategoryStatus
  description String?
  isFixed     Boolean?        @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  Expense      Expense[]
  FinanceEntry FinanceEntry[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Supplier {
  id     String  @id @default(uuid())
  name   String
  phone  String?
  street String?
  city   String?
  state  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]
}

enum EDiscountType {
  PERCENTAGE
  FIXED
}

enum EWhatsappProvider {
  ZAPI
  EVOLUTION
}

enum EMessageEvent {
  PAYMENT_OVERDUE
  BIRTHDAY
  EVENT_ANNOUNCEMENT
  ONE_MONTH_UNPAID
  PROMOTIONAL
}

enum EMessageStatus {
  SENT
  FAILED
}

model Promotion {
  id            String        @id @default(uuid())
  name          String
  description   String?
  discountType  EDiscountType
  discountValue Float
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

/// Credenciais do provedor de WhatsApp. Uma por usuário.
model WhatsappConfig {
  id           String            @id @default(uuid())
  provider     EWhatsappProvider
  baseUrl      String
  instanceId   String?
  /// Token do provedor. Nunca é devolvido ao cliente — ver whatsapp.getConfig.
  token        String
  senderNumber String
  isActive     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Texto por tipo de evento, com placeholders tipo {{aluno}}.
model MessageTemplate {
  id        String        @id @default(uuid())
  event     EMessageEvent
  name      String
  body      String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs MessageLog[]

  @@index([userId, event])
}

/// Histórico de envios, para não repetir disparo e para auditoria.
model MessageLog {
  id        String         @id @default(uuid())
  event     EMessageEvent
  body      String
  status    EMessageStatus
  error     String?
  toNumber  String
  createdAt DateTime       @default(now())

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([studentId, event, createdAt])
}
